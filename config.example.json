{
  "_comment": "Copy this file to ~/.claude/harness-audit-kit/config.json; the installer does it once.",
  "enabledDetectors": [
    "block-loop",
    "block-bypassed",
    "retry-verbatim",
    "tool-error-loop",
    "user-correction",
    "user-interrupt",
    "hook-error",
    "forbidden-pattern",
    "hook-slow",
    "subagent-max-turns",
    "agent-usage-limit"
  ],
  "thresholds": {
    "_comment": "hookSlowMaxMs is an opt-in single-run alarm: null disables it, an integer (ms, not below hookSlowMs) flags any one run that slow.",
    "blockLoop": 3,
    "toolErrorLoop": 3,
    "hookSlowMs": 5000,
    "hookSlowMaxMs": null,
    "hookSlowMinRuns": 20
  },
  "outcome": { "minSessions": 10, "regressionPct": 30 },
  "correctionPhrases": ["^wrong approach\\b"],
  "correctionStrongPhrases": [],
  "correctionWeakPhrases": [],
  "grantPhrases": ["^proceed\\b"],
  "replaceDefaultPhrases": false,
  "bypassPatterns": [],
  "forbidden": [
    {
      "id": "no-npm",
      "tool": "^Bash$",
      "field": "command",
      "pattern": "(^|\\s)npm\\s+(i|install)\\b",
      "message": "This project uses pnpm"
    }
  ],
  "ignoreProjects": [],
  "inject": { "maxItems": 5, "maxChars": 4000 },
  "queue": { "expireDays": 14 },
  "retentionDays": 60,
  "judge": { "enabled": false, "model": "haiku" },
  "projectsDir": null
}
